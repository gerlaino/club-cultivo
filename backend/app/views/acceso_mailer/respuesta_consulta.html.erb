<p style="font-size:16px; color:#0f172a; margin:0 0 12px;">Hola <%= @s.nombre %>,</p>
<div style="font-size:14px; color:#334155; line-height:1.7; margin:0 0 16px; white-space:pre-line;"><%= @r.texto %></div>
<p style="font-size:13px; color:#475569; margin:0 0 4px;"><%= @r.autor&.first_name.presence || 'El equipo' %> · Cultivo Espacial</p>
<p style="font-size:12px; color:#94a3b8; margin:16px 0 0;">Código de trámite: <%= @s.codigo %></p>
<% if @s.mensaje.present? %>
<blockquote style="font-size:12px; color:#64748b; border-left:3px solid #cbd5e1; margin:16px 0 0; padding:4px 0 4px 10px; white-space:pre-line;"><%= @s.mensaje %></blockquote>
<% end %>
