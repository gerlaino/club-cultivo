<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f8fafc; margin: 0; padding: 0; color: #0f172a; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .header { background: #1b5e20; padding: 28px 32px; }
    .header-title { color: #fff; font-size: 20px; font-weight: 700; margin: 0; }
    .header-sub { color: #a5d6a7; font-size: 13px; margin: 4px 0 0; }
    .banner-rec { background: #fef3c7; border-left: 4px solid #f59e0b; padding: 14px 20px; margin: 0; font-size: 14px; color: #78350f; }
    .body { padding: 28px 32px; }
    .kpi-row { display: flex; gap: 16px; margin-bottom: 24px; }
    .kpi { flex: 1; background: #f8fafc; border-radius: 8px; padding: 14px 16px; text-align: center; }
    .kpi-num { font-size: 28px; font-weight: 700; color: #0f172a; line-height: 1; }
    .kpi-label { font-size: 12px; color: #64748b; margin-top: 4px; }
    .section-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: #64748b; margin: 20px 0 10px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px; }
    th { text-align: left; font-size: 11px; font-weight: 700; color: #64748b; border-bottom: 2px solid #e2e8f0; padding: 6px 8px; }
    td { padding: 7px 8px; border-bottom: 1px solid #f1f5f9; }
    .cta { text-align: center; margin: 28px 0 0; }
    .btn { display: inline-block; background: #1b5e20; color: #fff; text-decoration: none; padding: 12px 28px; border-radius: 8px; font-weight: 700; font-size: 14px; }
    .footer { background: #f8fafc; padding: 16px 32px; text-align: center; font-size: 12px; color: #94a3b8; }
    .divider { height: 1px; background: #e2e8f0; margin: 20px 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <p class="header-title">🌿 Cultivo Espacial — Declaración jurada semestral</p>
      <p class="header-sub"><%= @club.name %> · <%= @semestre %>° semestre <%= @anio %></p>
    </div>

    <% if @modo == :recordatorio %>
    <div class="banner-rec">
      ⏰ <strong>Recordatorio:</strong> el plazo para presentar la declaración semestral ante REPROCANN vence en 30 días.
      Revisá los datos a continuación y completá la presentación.
    </div>
    <% end %>

    <div class="body">

      <% pac = @datos[:pacientes]; ent = @datos[:entregas]; cul = @datos[:cultivo][:cosechados] %>

      <p class="section-title">Pacientes registrados al <%= @datos[:periodo][:al].strftime('%d/%m/%Y') %></p>
      <div class="kpi-row">
        <div class="kpi">
          <div class="kpi-num"><%= pac[:registrados] %></div>
          <div class="kpi-label">Registrados</div>
        </div>
        <div class="kpi">
          <div class="kpi-num"><%= pac[:vigentes] %></div>
          <div class="kpi-label">Vigentes al cierre</div>
        </div>
        <div class="kpi">
          <div class="kpi-num" style="color:<%= pac[:vencidos] > 0 ? '#dc2626' : '#0f172a' %>"><%= pac[:vencidos] %></div>
          <div class="kpi-label">Vencidos al cierre</div>
        </div>
        <div class="kpi">
          <div class="kpi-num"><%= pac[:en_tramite] %></div>
          <div class="kpi-label">Pendientes de aprobación</div>
        </div>
      </div>
      <% if pac[:sin_registro] > 0 %>
      <p style="font-size:13px;color:#64748b;margin:0 0 16px"><%= pac[:sin_registro] %> pacientes sin registro: no se presentan, se informa el número.</p>
      <% end %>

      <div class="divider"></div>
      <p class="section-title">Cultivo y entregas del semestre</p>
      <div class="kpi-row">
        <div class="kpi">
          <div class="kpi-num"><%= cul[:lotes] %></div>
          <div class="kpi-label">Lotes cosechados</div>
        </div>
        <div class="kpi">
          <div class="kpi-num"><%= cul[:gramos].round(0) %> g</div>
          <div class="kpi-label">Flor seca</div>
        </div>
        <div class="kpi">
          <div class="kpi-num"><%= ent[:entregas] %></div>
          <div class="kpi-label">Entregas</div>
        </div>
        <div class="kpi">
          <div class="kpi-num"><%= ent[:pacientes] %></div>
          <div class="kpi-label">Pacientes atendidos</div>
        </div>
      </div>
      <% if ent[:por_unidad].any? %>
      <p style="font-size:13px;color:#64748b;margin:0 0 16px">Entregado: <%= ent[:por_unidad].map { |u| "#{u[:cantidad]} #{u[:unidad]}" }.join(' · ') %></p>
      <% end %>

      <% if @datos[:sin_vincular].any? %>
      <div class="banner-rec">
        ⚠️ <strong><%= @datos[:sin_vincular].size %> genéticas salen en la declaración sin vinculación con el INASE:</strong>
        <%= @datos[:sin_vincular].map { |g| g[:nombre] }.join(', ') %>. Declaralas desde su ficha antes de presentar.
      </div>
      <% end %>

      <div class="divider"></div>
      <div class="cta">
        <a class="btn" href="<%= url_app('/informe-semestral') %>">
          Ver la declaración completa →
        </a>
      </div>

    </div>

    <div class="footer">
      Cultivo Espacial · Plataforma de gestión para organizaciones que cultivan<br/>
      Este es un aviso automático generado por el sistema.
    </div>
  </div>
</body>
</html>
