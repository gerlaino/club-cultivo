<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f8fafc; margin: 0; padding: 0; color: #0f172a; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .header { background: #1b5e20; padding: 28px 32px; }
    .header-club { color: #a5d6a7; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; margin: 0 0 6px; }
    .header-title { color: #fff; font-size: 20px; font-weight: 700; margin: 0; line-height: 1.3; }
    .body { padding: 32px; }
    .message-body { font-size: 15px; color: #334155; line-height: 1.7; white-space: pre-wrap; }
    .divider { height: 1px; background: #e2e8f0; margin: 28px 0; }
    .sender { display: flex; align-items: center; gap: 12px; }
    .sender-label { font-size: 12px; color: #94a3b8; margin-bottom: 2px; }
    .sender-name { font-size: 14px; font-weight: 600; color: #0f172a; }
    .footer { background: #f8fafc; padding: 16px 32px; text-align: center; font-size: 12px; color: #94a3b8; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <p class="header-club">🌿 <%= @club.name %></p>
      <p class="header-title"><%= @asunto %></p>
    </div>

    <div class="body">
      <div class="message-body"><%= @cuerpo %></div>

      <div class="divider"></div>

      <div class="sender">
        <div>
          <div class="sender-label">Enviado por</div>
          <div class="sender-name"><%= @remitente.nombre_completo %> · <%= @club.name %></div>
        </div>
      </div>
    </div>

    <div class="footer">
      <%= @club.name %> · Plataforma de gestión de clubes cannábicos<br/>
      Este mensaje fue enviado a <%= @destinatario.presence || @destino %><%= " (#{@destino})" if @destinatario.present? %>.
    </div>
  </div>
</body>
</html>
